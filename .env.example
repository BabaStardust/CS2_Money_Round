# Kopieren nach .env und ausfüllen. .env nie committen.

# Featurestore + Model Registry:
#   hopsworks (Abgabe) | local (Parquet unter data/featurestore, Modelle unter models/registry)
#   | example (mitgelieferter Schnappschuss examples/store, nur Inferenz, ohne Zugang)
FEATURE_STORE=hopsworks
# Standard-Quelle der Web-App (Schalter oben auf der Seite); leer = example
# APP_FEATURE_STORE=hopsworks
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=cs2_ml

# Vision-Modell für Screenshots: anthropic | claude_cli | granite | openai_compatible
#   granite = IBM Granite Vision 3.3 2B lokal (uv sync --extra granite), kein Key nötig
VISION_PROVIDER=anthropic
VISION_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# nur für openai_compatible (lokales Modell, z. B. oMLX / LM Studio / Ollama):
# VISION_BASE_URL=http://localhost:8000/v1
# VISION_API_KEY=
# nur für granite (Standard: ibm-granite/granite-vision-3.3-2b):
# GRANITE_MODEL=ibm-granite/granite-vision-3.3-2b
