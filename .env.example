# Kopieren nach .env und ausfüllen. .env nie committen.

# Featurestore + Model Registry: hopsworks (Abgabe) oder local (Parquet unter data/featurestore, Modelle unter models/registry)
FEATURE_STORE=hopsworks
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=CAS_MLOps_CS2

# Vision-Modell für Screenshots: anthropic | openai_compatible | claude_cli
VISION_PROVIDER=anthropic
VISION_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# nur für openai_compatible (lokales Modell, z. B. oMLX / LM Studio / Ollama):
# VISION_BASE_URL=http://localhost:8000/v1
# VISION_API_KEY=
